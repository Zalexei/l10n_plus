{
  "@@locale": "en",
  "@@last_modified": "2026-01-01T00:00:00Z",

  "auth.login.title": "Log in",
  "@auth.login.title": {
    "description": "Title of the login screen"
  },

  "auth.login.subtitle": "Welcome back, {name}",
  "@auth.login.subtitle": {
    "description": "Shown under the login title",
    "placeholders": {
      "name": {
        "type": "String",
        "description": "The signed in user's first name",
        "example": "Alex"
      }
    }
  },

  "wallet.price": "Price: {amount}",
  "@wallet.price": {
    "description": "A price always quoted in US dollars",
    "placeholders": {
      "amount": {
        "type": "double",
        "format": "currency",
        "optionalParameters": {"name": "USD"}
      }
    }
  },

  "wallet.rounded": "Rounded: {amount}",
  "@wallet.rounded": {
    "description": "A whole-dollar amount shown with the local symbol",
    "placeholders": {
      "amount": {
        "type": "double",
        "format": "simpleCurrency",
        "optionalParameters": {"name": "USD", "decimalDigits": 0}
      }
    }
  },

  "wallet.tip": "Tip: {amount, number, currency:EUR}",

  "wallet.cards": "You have {count, plural, one{# card} other{# cards}} linked",

  "wallet.transactions": "{count, plural, =0{No transactions} one{1 transaction} other{{count} transactions}}",
  "wallet.statement": "Statement from {from} for {amount}",
  "@wallet.statement": {
    "description": "Header of the monthly statement",
    "placeholders": {
      "from": {"type": "DateTime", "format": "yMMMd", "example": "Mar 14, 2026"},
      "amount": {"type": "double", "format": "currency"}
    }
  },

  "@wallet.transactions": {
    "description": "Number of transactions in the wallet",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "5"
      }
    }
  }
}
